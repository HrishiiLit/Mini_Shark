# Global ignore rules for the repository

# Python virtual environments
.venv/
venv/
.env/

# Byte‑compiled / cache files
__pycache__/
*.py[cod]
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
.dist/
.build/
.ruff_cache/

# SQLite databases
*.db
*.sqlite

# Logs
*.log

# PCAP captures (tracked test fixtures need `git add -f`)
*.pcap
*.pcapng

# IDE / editor artefacts
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store

# Executable binaries
*.exe
*.out
*.dll
*.so

.pytest_cache/

# Node / npm artefacts (if frontend uses npm)
node_modules/
